# 服务端口
PORT=8787

# 数据目录（SQLite 与上传文件都放这里，Docker 里挂卷）
DATA_DIR=./data

# 必改：JWT 签名密钥，32 位以上随机串
JWT_SECRET=请替换成32位以上随机字符串

# 后台账号
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=请替换成强密码

# ---------------- Casdoor（可选）----------------
# 开启后客户端可以走 Casdoor 登录，支持微信 / QQ / Apple / GitHub 等
# 不开启时用本地账号密码，行为与 v1 一致
CASDOOR_ENABLED=0
CASDOOR_ENDPOINT=https://door.example.com
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORG=built-in
CASDOOR_APP=app-built-in
# 客户端回跳协议，APP 内用 isle://auth
CASDOOR_REDIRECT=isle://auth

# ---------------- 业务参数 ----------------
# 卡密前缀
CODE_PREFIX=MT
# 设备上限
DEVICE_LIMIT=5
# 解绑冷却（小时）
UNBIND_COOLDOWN_HOURS=168
# 邀请奖励积分
INVITE_POINTS=200
# 签到基础积分
CHECKIN_POINTS=30
